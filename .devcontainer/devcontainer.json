// .NET - C#, F#, Blazor, MSBuild, NuGet, SpecFlow.
//
// GENERATED by vscode/scripts/build.ps1 from profiles.json + build/{base, docs, dotnet, dotnet-blazor, dotnet-fsharp, bdd}.
// Edit those and re-run the script; changes here are overwritten.
{
  "name": ".NET",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "installZsh": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "forwardPorts": [
    5000,
    5001,
    7000
  ],
  "containerEnv": {
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "postCreateCommand": "(sudo apt-get update && sudo apt-get install -y --no-install-recommends graphviz) && (dotnet restore || true)",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "christian-kohler.path-intellisense",
        "esbenp.prettier-vscode",
        "oderwat.indent-rainbow",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "tamasfe.even-better-toml",
        "humao.rest-client",
        "formulahendry.code-runner",
        "visualstudioexptteam.vscodeintellicode",
        "visualstudioexptteam.intellicode-api-usage-examples",
        "ms-vsliveshare.vsliveshare",
        "bierner.markdown-mermaid",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "mermaidchart.vscode-mermaid-chart",
        "hediet.vscode-drawio",
        "darkriszty.markdown-table-prettify",
        "tomoki1207.pdf",
        "cweijan.vscode-office",
        "tintinweb.graphviz-interactive-preview",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-dotnettools.vscodeintellicode-csharp",
        "fernandoescolar.vscode-solution-explorer",
        "formulahendry.dotnet-test-explorer",
        "tintoy.msbuild-project-tools",
        "selcukermaya.se-csproj-extensions",
        "fudge.auto-using",
        "gaoshan0621.csharp-format-usings",
        "adrianwilczynski.namespace",
        "jchannon.csharpextensions",
        "k--kato.docomment",
        "dominicvonk.vscode-resx-editor",
        "oleg-shilo.cs-script",
        "patcx.vscode-nuget-gallery",
        "eridem.vscode-nupkg",
        "dotjoshjohnson.xml",
        "ms-vscode.powershell",
        "amillard98.specflow-tools",
        "adrianwilczynski.blazor-snippet-pack",
        "adrianwilczynski.csharp-to-typescript",
        "adrianwilczynski.format-selection-as-html",
        "ionide.ionide-fsharp",
        "cucumberopen.cucumber-official",
        "alexkrechik.cucumberautocomplete"
      ],
      "settings": {
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "editor.formatOnSave": true,
        "editor.bracketPairColorization.enabled": true,
        "git.autofetch": true,
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "markdown.extension.toc.levels": "2..4",
        "dotnet.server.useOmnisharp": false,
        "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
        "csharp.inlayHints.enableInlayHintsForParameters": true,
        "omnisharp.enableRoslynAnalyzers": true,
        "dotnet-test-explorer.testProjectPath": "**/*Tests.csproj",
        "FSharp.enableTreeView": true
      }
    },
    "jetbrains": {
      "backend": "Rider"
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
